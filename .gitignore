# 想你机 · think-of-you
#
# 这是一个纯 Lua 应用项目，没有编译产物，因此忽略清单不长。
# 关键原则：绝不能用 `*.lua` 之类的模式，否则会连应用本体一起忽略。
# 需要忽略的 Lua 只有编译器输出（*.luac）和本机私密副本。

# ────────────────────────────────
# 操作系统
# ────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
Thumbs.db
ehthumbs.db
desktop.ini

# ────────────────────────────────
# 编辑器 / IDE
# ────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/
*.code-workspace

# ────────────────────────────────
# Lua 工具链输出
# 源码是纯文本，只有编译后的字节码需要忽略。
# ────────────────────────────────
*.luac
luac.out
.luacheckcache
.luarc.json.local
.luarocks/
lua_modules/
.rocks/

# ────────────────────────────────
# 本机敏感配置（重要）
# think-of-you.lua 中的 TOPIC 相当于密码，KEY 是本机身份。
# 想保留一份填了真实值的副本时，请用下面这些名字，
# 它们不会被提交，本体请继续使用占位值。
# ────────────────────────────────
config.local.lua
secrets.lua
*.local.lua
*.secret.lua

# ────────────────────────────────
# 本机调试副本
# 从设备拉取（adb pull）或按设备临时改名的脚本，仅用于本地联调。
# ────────────────────────────────
device-app.lua
device-*.lua
miniapp.lua

# ────────────────────────────────
# 运行与验证产物
# headless 截图、日志、临时文件。
# ────────────────────────────────
*.log
shot.png
screenshot*.png
*.tmp
*.bak
*.orig
*.rej

# ────────────────────────────────
# 本地模拟器检出（可选）
# 本项目不含模拟器源码。若你为了调试把 SDK 克隆到本目录内，
# 下面的规则可以避免把庞大的第三方源码误提交进来。
# ────────────────────────────────
/LingClaw-SDK/
/target/
/vendor/
