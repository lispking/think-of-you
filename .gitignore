# 想你机 · think-of-you
#
# 主体是一个纯 Lua 应用（think-of-you.lua），没有编译产物。
#
# 关键原则：
#   1. 绝不能用 `*.lua` 之类的模式，否则会连应用本体一起忽略。
#      需要忽略的 Lua 只有编译器输出（*.luac）和本机私密副本。
#   2. 真实 TOPIC 相当于密码，只写在被忽略的本机副本里，应用本体保持占位值。

# ────────────────────────────────
# 操作系统
# ────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
Thumbs.db
ehthumbs.db
desktop.ini

# ────────────────────────────────
# 编辑器 / IDE
# ────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/
*.code-workspace

# ────────────────────────────────
# 本机 agent 状态 · .atomcode/
# 会话记录、项目本地记忆（含硬件配对等本机信息）都在这里，仅存本机。
# ────────────────────────────────
.atomcode/

# ────────────────────────────────
# Lua 工具链输出
# 源码是纯文本，只有编译后的字节码需要忽略。
# ────────────────────────────────
*.luac
luac.out
.luacheckcache
.luarc.json.local
.luarocks/
lua_modules/
.rocks/

# ────────────────────────────────
# 本机敏感配置（重要）
# think-of-you.lua 中的 TOPIC 相当于密码，KEY 是本机身份。
# 想保留一份填了真实值的副本时，请用下面这些名字，
# 它们不会被提交，本体请继续使用占位值。
# ────────────────────────────────
config.local.lua
secrets.lua
*.local.lua
*.secret.lua

# ────────────────────────────────
# 本机调试副本
# 从设备拉取（adb pull）或按设备临时改名的脚本，仅用于本地联调。
# flash.sh 生成的两份产物也在这里：注入真实 TOPIC 的烧录副本，
# 以及它记住的主题名（主题名相当于密码，不能提交）。
# ────────────────────────────────
device-app.lua
device-*.lua
device-*.topic
miniapp.lua

# ────────────────────────────────
# 运行与验证产物
# headless 截图、日志、临时文件。
# ────────────────────────────────
*.log
shot.png
screenshot*.png
*.tmp
*.bak
*.orig
*.rej

# ────────────────────────────────
# 本地模拟器检出（可选）
# 本项目不含模拟器源码。若你为了调试把 SDK 克隆到本目录内，
# 下面的规则可以避免把庞大的第三方源码误提交进来。
# ────────────────────────────────
/LingClaw-SDK/
/target/
/vendor/

# ────────────────────────────────
# Python 工具链
# 屏蔽解释器与工具缓存；以后若有脚本改用 Python，直接沿用这一段。
# ────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# 虚拟环境与依赖安装目录（体积大，按 requirements 可重建）
.venv/
venv/
env/
ENV/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ────────────────────────────────
# 本地宣传片工程 · video/
# 介绍片的脚本与导出产物都只在本机跑：帧序列、音频、成片体积大且可重跑，
# 脚本也不随仓库发布。README 里用到的截图单独放在 assets/。
# ────────────────────────────────
video/
