# 想你机 · think-of-you
#
# 主体是一个纯 Lua 应用（think-of-you.lua），没有编译产物。
# 另有 video/ 目录，存放宣传片的离线生成脚本（Python + ffmpeg）。
#
# 关键原则：
#   1. 绝不能用 `*.lua` 之类的模式，否则会连应用本体一起忽略。
#      需要忽略的 Lua 只有编译器输出（*.luac）和本机私密副本。
#   2. video/ 里的帧序列、音频、成品视频都是体积巨大且可再生的产物，
#      一律忽略；但生成它们的脚本（*.py、字幕 md）必须保留。

# ────────────────────────────────
# 操作系统
# ────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
Thumbs.db
ehthumbs.db
desktop.ini

# ────────────────────────────────
# 编辑器 / IDE
# ────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.project
.classpath
.settings/
*.code-workspace

# ────────────────────────────────
# Lua 工具链输出
# 源码是纯文本，只有编译后的字节码需要忽略。
# ────────────────────────────────
*.luac
luac.out
.luacheckcache
.luarc.json.local
.luarocks/
lua_modules/
.rocks/

# ────────────────────────────────
# 本机敏感配置（重要）
# think-of-you.lua 中的 TOPIC 相当于密码，KEY 是本机身份。
# 想保留一份填了真实值的副本时，请用下面这些名字，
# 它们不会被提交，本体请继续使用占位值。
# ────────────────────────────────
config.local.lua
secrets.lua
*.local.lua
*.secret.lua

# ────────────────────────────────
# 本机调试副本
# 从设备拉取（adb pull）或按设备临时改名的脚本，仅用于本地联调。
# ────────────────────────────────
device-app.lua
device-*.lua
miniapp.lua

# ────────────────────────────────
# 运行与验证产物
# headless 截图、日志、临时文件。
# ────────────────────────────────
*.log
shot.png
screenshot*.png
*.tmp
*.bak
*.orig
*.rej

# ────────────────────────────────
# 本地模拟器检出（可选）
# 本项目不含模拟器源码。若你为了调试把 SDK 克隆到本目录内，
# 下面的规则可以避免把庞大的第三方源码误提交进来。
# ────────────────────────────────
/LingClaw-SDK/
/target/
/vendor/

# ────────────────────────────────
# Python 工具链
# video/ 下的脚本用 Python 跑，这里屏蔽解释器与工具缓存。
# ────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo

# 虚拟环境与依赖安装目录（体积大，按 requirements 可重建）
.venv/
venv/
env/
ENV/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ────────────────────────────────
# 宣传片工程 · video/
# 除脚本和字幕文档外，其余全部是本地生成的产物：
#   audio/     —— 合成语音、BGM、混音（可重跑 make_audio.py 得到）
#   frames/    —— 900 张 PNG 帧序列（约 1.7G）
#   out/       —— 渲染完成的分辨率成片（mp4）
#   preview/   —— 抽帧预览图
# 这些都能靠 render.py / make_audio.py 重新生成，不进版本库。
# ────────────────────────────────
video/audio/
video/frames/
video/out/
video/preview/

# 生成过程中的中间件（若脚本以后输出到别处也一并挡住）
video/*.wav
video/*.aiff
video/*.mp3
video/*.m4a
video/*.mp4
video/*.mov
video/*.mkv

# 只有视频根目录的脚本与字幕文档需要保留，其余仍被上面规则忽略。
!video/*.py
!video/*.md
!video/requirements*.txt
